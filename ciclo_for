# Tabla de tokens:
#   for     : 100
#   in      : 110
#   :       : 120
#   else    : 130
#   ID      : 600
#   SUITE   : 700
#   SIMPLE  : 800

vector = [100, 600, 110, 600, 120, 700, 130, 120, 700]

def start(tokens):
    error = ''
    i = 0
    i, error = for_stmt(tokens, i)
    if error != '':
        return error
    if i < len(tokens):
        return f"Error sintáctico: Símbolo inesperado '{tokens[i]}' en la posición {i}"
    return 'VÁLIDO'

def for_stmt(tokens, i):
    if i < len(tokens) and tokens[i] == 100:
        i = i + 1
    else:
        return i, "Se esperaba la palabra clave 'for'"

    if i < len(tokens) and tokens[i] == 600:
        i = i + 1
    else:
        return i, "Se esperaba un identificador (target_list)"

    if i < len(tokens) and tokens[i] == 110:
        i = i + 1
    else:
        return i, "Se esperaba la palabra clave 'in'"

    if i < len(tokens) and tokens[i] == 600:
        i = i + 1
    else:
        return i, "Se esperaba una expresión (expression_list)"

    if i < len(tokens) and tokens[i] == 120:
        i = i + 1
    else:
        return i, "Se esperaba ':' después de la expresión"

    i, error = body(tokens, i)
    if error != '':
        return i, error

    return i, ''

def body(tokens, i):
    if i < len(tokens) and tokens[i] == 800:
        i = i + 1
        return i, ''
        
    elif i < len(tokens) and tokens[i] == 700:
        i = i + 1
        
        if i < len(tokens) and tokens[i] == 130:
            i = i + 1
            
            if i < len(tokens) and tokens[i] == 120:
                i = i + 1
            else:
                return i, "Se esperaba ':' después de 'else'"
                
            if i < len(tokens) and tokens[i] == 700:
                i = i + 1
            else:
                return i, "Se esperaba un bloque 'suite' después de 'else:'"
                
        return i, ''
        
    else:
        return i, "Se esperaba un bloque de instrucciones (simple_stmt o suite) después de ':'"

print(start(vector))
