# Tabla de tokens:
#   def         : 400
#   FUNC_NAME   : 410
#   (           : 250
#   )           : 260
#   :           : 120
#   PARAM       : 420
#   ,           : 430
#   STATEMENT   : 900

vector = [400, 410, 250, 420, 430, 420, 260, 120, 900]

def start(tokens):
    error = ''
    i = 0
    i, error = def_funcion(tokens, i)
    if error != '':
        return error
    if i < len(tokens):
        return f"Error sintáctico: Símbolo inesperado '{tokens[i]}' en la posición {i}"
    return 'VÁLIDO'

def def_funcion(tokens, i):
    if i < len(tokens) and tokens[i] == 400:
        i = i + 1
    else:
        return i, "Se esperaba la palabra clave 'def'"

    if i < len(tokens) and tokens[i] == 410:
        i = i + 1
    else:
        return i, "Se esperaba el nombre de la función"

    if i < len(tokens) and tokens[i] == 250:
        i = i + 1
    else:
        return i, "Se esperaba '('"

    if i < len(tokens) and tokens[i] == 420:
        i = i + 1
        while i < len(tokens) and tokens[i] == 430:
            if i < len(tokens) and tokens[i] == 430:
                i = i + 1
            else:
                return i, 'Se esperaba una coma'
            if i < len(tokens) and tokens[i] == 420:
                i = i + 1
            else:
                return i, 'Se esperaba un parámetro después de la coma'

    if i < len(tokens) and tokens[i] == 260:
        i = i + 1
    else:
        return i, "Se esperaba ')'"

    if i < len(tokens) and tokens[i] == 120:
        i = i + 1
    else:
        return i, "Se esperaba ':'"

    i, error = body(tokens, i)
    if error != '':
        return i, error

    return i, ''

def body(tokens, i):
    if i < len(tokens) and tokens[i] == 900:
        i = i + 1
        return i, ''
    else:
        return i, "Se esperaba el cuerpo de la función (statement)"

print(start(vector))
