# Tabla de tokens:
#   or      : 200
#   and     : 210
#   not     : 220
#   True    : 230
#   False   : 240
#   (       : 250
#   )       : 260
#   TERMINO : 300

vector = [250, 300, 200, 230, 260, 210, 220, 240]

def start(tokens):
    error = ''
    i = 0
    i, error = expresion_logica(tokens, i)
    if error != '':
        return error
    if i < len(tokens):
        return f"Error sintáctico: Símbolo inesperado '{tokens[i]}' en la posición {i}"
    return 'VÁLIDO'

def expresion_logica(tokens, i):
    i, error = termino(tokens, i)
    if error != '':
        return i, error
    
    while i < len(tokens) and tokens[i] in (200, 210):
        if i < len(tokens) and tokens[i] in (200, 210):
            i = i + 1
        else:
            return i, 'Se esperaba un operador lógico'
        i, error = termino(tokens, i)
        if error != '':
            return i, error
    return i, ''

def termino(tokens, i):
    i, error = factor(tokens, i)
    if error != '':
        return i, error
    while i < len(tokens) and tokens[i] == 210:
        if i < len(tokens) and tokens[i] == 210:
            i = i + 1
        else:
            return i, 'Se esperaba un operador and'
        i, error = factor(tokens, i)
        if error != '':
            return i, error
    return i, ''

def factor(tokens, i):
    if i < len(tokens) and tokens[i] == 220:
        if i < len(tokens) and tokens[i] == 220:
            i = i + 1
        else:
            return i, 'Se esperaba not'
        i, error = factor(tokens, i)
        return i, error
        
    elif i < len(tokens) and tokens[i] == 250:
        if i < len(tokens) and tokens[i] == 250:
            i = i + 1
        else:
            return i, 'Se esperaba un parentesis de apertura'
        i, error = expresion_logica(tokens, i)
        if error != '':
            return i, error
        if i < len(tokens) and tokens[i] == 260:
            i = i + 1
        else:
            return i, 'Se esperaba un parentesis de cierre'
        return i, ''
        
    elif i < len(tokens) and tokens[i] in (230, 240):
        i = i + 1
        return i, ''
        
    elif i < len(tokens) and tokens[i] == 300:
        i = i + 1
        return i, ''
        
    else:
        return i, 'Se esperaba una expresión lógica válida'

print(start(vector))
